# Legal AI Chatbot Environment Configuration

# OpenAI API Key (optional - for OpenAI embeddings and GPT models)
OPENAI_API_KEY=your_openai_api_key_here

# Groq API Key (recommended - for fast inference)
GROQ_API_KEY=your_groq_api_key_here

# Hugging Face API Key (optional - for HuggingFace embeddings)
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Database Configuration
CHROMA_DB_PATH=./chroma_db
DATA_DIRECTORY=./Data

# Model Configuration
DEFAULT_EMBEDDING_MODEL=huggingface  # Options: openai, huggingface
DEFAULT_LLM_PROVIDER=groq           # Options: groq, openai
DEFAULT_MODEL_NAME=llama3-8b-8192   # For Groq: llama3-8b-8192, mixtral-8x7b-32768

# Chunking Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=False